# Dragon Realm — environment variables
#
# ALL EIGHT sites (the hub and the seven games) use the SAME values. Add this same list to every Vercel project
# (Project -> Settings -> Environment Variables), then redeploy. They are read at build time.
#
# You only NEED these if a site's real address differs from the default shown here. The defaults are what the code
# assumes when a variable is missing. Replace each value with the real address Vercel gives that project
# (no trailing slash). Every address must be https.

# --- The hub (DracoPyre Strike) -------------------------------------------------------------------------------
VITE_HUB_URL=https://draco-pyre-strike.vercel.app

# --- The seven game sites -------------------------------------------------------------------------------------
VITE_URL_DRAGON_STRIKE=https://dragon-strike-shooter-site.vercel.app
VITE_URL_EMBER_WYRM=https://ember-wyrm-site.vercel.app
VITE_URL_DRAKEBREAKER=https://drakebreaker-site.vercel.app
VITE_URL_DRAGON_FLIGHT=https://dragon-flight-site.vercel.app
VITE_URL_DRAGON_2048=https://dragon-2048-site.vercel.app
VITE_URL_DRAGON_SUDOKU=https://dragon-sudoku-site.vercel.app
VITE_URL_DRAGON_TICTACTOE=https://dragon-tictactoe-site.vercel.app

# --- Shared database (optional) -------------------------------------------------------------------------------
# Only set these to point every site at a different Supabase project. The publishable key is public by design.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
